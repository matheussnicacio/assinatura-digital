# Copie para .env e TROQUE todos os valores de exemplo.
# MongoDB local (contêiner). Use apenas letras e números na senha (vai dentro de uma URL).
MONGO_USER=assinatura
MONGO_PASSWORD=1234
MONGODB_URI=mongodb+srv://pmatheusnicacio_db_user:SUA_SENHA@cluster0.810pkz1.mongodb.net/assinatura?retryWrites=true&w=majority
# Para banco em nuvem (MongoDB Atlas), descomente e preencha:
# MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/assinatura?retryWrites=true&w=majority

# Segredo do JWT (mín. 32 caracteres). Gere com:  openssl rand -hex 32
JWT_SECRET=52b8c2978d3e029a32a700aae07dc031529ba200bd4d40444441f3b2586b2aff
JWT_EXPIRES=1h

# Origem(ns) do frontend autorizadas no CORS (separe por vírgula)
CORS_ORIGINS=http://localhost:3002
APP_URL=http://localhost:3002

# URLs públicas da API usadas ao construir o frontend
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_API_ORIGIN=http://localhost:4000

# Primeiro gerente (criado só se o banco estiver vazio). Senha: 10+ caracteres, maiúscula, minúscula e número.
SEED_MANAGER_NAME=Gerente Geral
SEED_MANAGER_EMAIL=gerente@empresa.com
SEED_MANAGER_PASSWORD=gerente1234

# E-mail: por padrão usa o MailHog do compose. Em produção, aponte para o seu SMTP.
